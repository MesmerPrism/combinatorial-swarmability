{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mesmerprism.com/schemas/combinatorial-swarmability-public-catalog-v1.json",
  "title": "Combinatorial Swarmability public atlas catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "export_version", "source_binding", "items"],
  "properties": {
    "schema": {
      "const": "combinatorial.swarmability.public.catalog.v1"
    },
    "export_version": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[0-9]+$"
    },
    "source_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "sha256", "row_count", "schema_sha256", "profile_sha256"],
      "properties": {
        "authority": { "const": "research-memory" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "row_count": { "type": "integer", "minimum": 1 },
        "schema_sha256": { "$ref": "#/$defs/sha256" },
        "profile_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nullableUrl": {
      "type": ["string", "null"],
      "format": "uri"
    },
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_id", "display_order", "title", "source", "reported", "reconstruction", "facets"],
      "properties": {
        "public_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "display_order": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_id", "system_or_study", "year", "paper_url", "project_url", "artifact_url", "source_locus", "evidence_kind", "literature_status", "catalog_projection_status", "checked_on"],
          "properties": {
            "source_id": { "type": "string", "pattern": "^cs-source-[a-z0-9-]+$" },
            "system_or_study": { "type": "string", "minLength": 1 },
            "year": { "type": "integer", "minimum": 1900, "maximum": 2100 },
            "paper_url": { "$ref": "#/$defs/nullableUrl" },
            "project_url": { "$ref": "#/$defs/nullableUrl" },
            "artifact_url": { "$ref": "#/$defs/nullableUrl" },
            "source_locus": { "type": "string", "minLength": 1 },
            "evidence_kind": { "type": "string", "minLength": 1 },
            "literature_status": { "type": "string", "minLength": 1 },
            "catalog_projection_status": { "type": "string", "minLength": 1 },
            "checked_on": { "type": "string", "format": "date" }
          }
        },
        "reported": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input_expression", "input_routes", "user_action", "semantic_action", "control_family", "controlled_quantity", "parameter_exposure", "target_scope", "temporal_mode", "human_configuration", "multi_user_combination", "substrate"],
          "properties": {
            "input_expression": { "type": "string", "minLength": 1 },
            "input_routes": { "type": "string", "minLength": 1 },
            "user_action": { "type": "string", "minLength": 1 },
            "semantic_action": { "type": "string", "minLength": 1 },
            "control_family": { "type": "string", "minLength": 1 },
            "controlled_quantity": { "type": "string", "minLength": 1 },
            "parameter_exposure": { "type": "string", "minLength": 1 },
            "target_scope": { "type": "string", "minLength": 1 },
            "temporal_mode": { "type": "string", "minLength": 1 },
            "human_configuration": { "type": "string", "minLength": 1 },
            "multi_user_combination": { "type": "string", "minLength": 1 },
            "substrate": { "type": "string", "minLength": 1 }
          }
        },
        "reconstruction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "summary", "interaction", "effect", "semantic_actions", "transfer_boundary", "does_not_claim"],
          "properties": {
            "status": { "enum": ["implemented-reconstruction", "planned-reconstruction"] },
            "summary": { "type": "string", "minLength": 1 },
            "interaction": { "type": "string", "minLength": 1 },
            "effect": { "type": "string", "minLength": 1 },
            "semantic_actions": { "$ref": "#/$defs/stringArray" },
            "transfer_boundary": { "type": "string", "minLength": 1 },
            "does_not_claim": { "type": "string", "minLength": 1 }
          }
        },
        "facets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input_routes", "control_families", "scopes", "temporal_modes", "multi_user_policies", "substrates", "evidence_statuses"],
          "properties": {
            "input_routes": { "$ref": "#/$defs/stringArray" },
            "control_families": { "$ref": "#/$defs/stringArray" },
            "scopes": { "$ref": "#/$defs/stringArray" },
            "temporal_modes": { "$ref": "#/$defs/stringArray" },
            "multi_user_policies": { "$ref": "#/$defs/stringArray" },
            "substrates": { "$ref": "#/$defs/stringArray" },
            "evidence_statuses": { "$ref": "#/$defs/stringArray" }
          }
        }
      }
    }
  }
}
